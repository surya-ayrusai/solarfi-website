        "jsCode": "const row = $input.all().map((i) => i.json).find((r) => r && r.lead_id);\nif (!row) return [{ json: { status: 404, body: { ok: false, error: 'lead_not_found' } } }];\nreturn [{ json: { status: 200, body: { ok: true, lead: row } } }];\n"
      }
